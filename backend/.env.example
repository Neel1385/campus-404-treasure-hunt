# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database ----
# MongoDB Atlas connection string (replace <user>, <password>, <cluster>)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/campus404

# ---- Auth ----
# Generate a long random string: run `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Frontend URLs ----
# Comma-separated for multiple origins (CORS + Socket.IO).
# Production example:
CLIENT_URL=http://localhost:5173,https://campus404.vercel.app
FRONTEND_URL=https://campus404.vercel.app

# ---- Admin account (used by seed / create-admin scripts) ----
ADMIN_EMAIL=admin@campus404.org
ADMIN_PASSWORD=Admin@404!
ADMIN_NAME=Event Organizer

# ---- Reset guard ----
# Allow the "reset event" admin action. Enable only for dev/test, not in production.
ALLOW_RESET_EVENT=false
